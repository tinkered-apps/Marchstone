{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marchstone",
  "compatibility_date": "2026-09-23",
  // Static assets only: no Worker script, so every request is served straight
  // from public/. Nothing outside it is uploaded.
  "assets": { "directory": "./public" },

  // Workers Logs is on by default for a new Worker. Off here: the app holds no
  // account and no server-side data, and request logs would keep visitor
  // addresses beyond the sample Cloudflare's dashboard shows (see privacy.html).
  "observability": { "enabled": false },

  // One address for the app. No workers.dev or preview copy of it to find by accident.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "marchstone.tinkered.app", "custom_domain": true }
  ]
}
